# Server Configuration
NODE_ENV=production
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB ReplicaSet required for transactions)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/backend-ledger?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_32chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis (For BullMQ Email Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP Email Setup
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Bank App <noreply@bankapp.com>"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_STRICT_MAX=15
